# GridSense frontend — deployment environment.
#
# Copy to .env.local for local overrides (that file is gitignored). Neither
# variable is needed to run locally: the defaults in next.config.ts and
# documentation/page.tsx already point at http://127.0.0.1:8000, which is where
# `python -m uvicorn backend.main:app --port 8000` serves the API.
#
# Both are set in the Vercel project's Environment Variables panel.

# Where the Next.js rewrite proxy forwards /api/* .
# Server-side only, so it is deliberately NOT prefixed with NEXT_PUBLIC_ — the
# browser never sees it and never talks to the backend host directly.
# Set this to the deployed FastAPI base URL, with no trailing slash.
BACKEND_URL=https://gridsense-api.onrender.com

# The "API Documentation" card on /documentation links straight to FastAPI's
# own Swagger page, which is served at /docs and therefore sits outside the
# /api/* proxy. This one IS public because it is a link the browser follows.
NEXT_PUBLIC_API_DOCS_URL=https://gridsense-api.onrender.com/docs

# Deliberately NOT set: NEXT_PUBLIC_API_URL.
#
# src/lib/api.ts falls back to "" when it is unset, which makes every request a
# relative /api/* call that the rewrite above proxies. That is what keeps the
# app same-origin, so no CORS configuration is load-bearing — and it is the only
# arrangement in which the embedded GIS explorer works, because
# public/gis/app.js builds its own relative /api/* URLs and cannot be told about
# a different host.
#
# Setting NEXT_PUBLIC_API_URL to the backend origin would send the React pages
# cross-origin while the GIS iframe kept using the proxy: two different paths to
# the same data, and one of them dependent on the backend's CORS list.
